# JAX Environment Configuration
# Copy to .env and fill in values. NEVER commit real secrets here.

# Admin token (required, min 32 chars)
JAX_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Allowed project roots for Git preflight (required to use /v1/sessions/preflight)
# A project whose local path is not listed here is refused with
# 403 "Project root is not allowlisted" -- this is deliberate fail-closed
# behaviour, not a bug. List the exact repository root (not its parent), and
# separate multiple entries with your platform's path separator
# (Windows: ";"   POSIX: ":").
#JAX_PROJECT_ROOTS=C:\Users\blunt\repos\jax

# Database (Supabase)
# The app reads JAX_DATABASE_URL first, then this variable. With neither set it
# falls back to local SQLite, which fails on read-only hosts such as Vercel.
# Direct connection may fail from IPv4-only networks; use Management API for migrations
SUPABASE_DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase Management API (for migrations and direct SQL)
SUPABASE_PAT=sbp_your_supabase_personal_access_token
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Model provider: ollama | openrouter | openai | groq | stub
#
#   ollama     local inference, no API key, nothing leaves the machine
#   openrouter / openai / groq   require an API key; chat returns 503 without one
#   stub       returns a fixed placeholder, for testing the plumbing only
#
# An unrecognised value now fails at startup rather than silently degrading
# to a stub that looks like a working deployment.
JAX_PROVIDER=ollama

# Used by whichever provider is selected. For ollama this is a pulled model
# name; `ollama list` shows what you have. Check with GET /v1/provider/health.
JAX_MODEL=qwen3-coder:30b

# Local Ollama endpoint. Loopback by default and should stay that way: Ollama
# has no authentication of its own, so an exposed port is an open inference
# endpoint for anyone who can reach it.
OLLAMA_HOST=http://127.0.0.1:11434

# API keys
OPENROUTER_API_KEY=sk-or-your_openrouter_key
OPENAI_API_KEY=sk-your_openai_key
GROQ_API_KEY=gsk_your_groq_key

# Voice (OpenAI TTS + Whisper)
# Uses OPENAI_API_KEY above

# Server
JAX_HOST=127.0.0.1
JAX_PORT=8788
